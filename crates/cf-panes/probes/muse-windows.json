  {
   "name": "muse-hooks",
   "argv": [
    "${LOCALAPPDATA}\\Programs\\muse\\muse-bin-1.4.13-R6996.1.exe",
    "-c",
    "hooks={\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"'C:\\\\Windows\\\\System32\\\\cmd.exe' /c echo command-ran> \\\"${TEMP_JSON}\\\\command.txt\\\"\",\"timeout\":10},{\"type\":\"command\",\"command\":\"echo posix-form-unused\",\"commandWindows\":\"& 'C:\\\\Windows\\\\System32\\\\cmd.exe' /c echo windows-ran> '${TEMP_JSON}\\\\windows.txt'\",\"timeout\":10},{\"type\":\"command\",\"command\":\"$PSVersionTable.PSVersion.ToString() | Out-File -LiteralPath '${TEMP_JSON}\\\\ps.txt'\",\"timeout\":10},{\"type\":\"command\",\"command\":\"echo posix-form-unused\",\"commandWindows\":\"$input | Out-File -LiteralPath '${TEMP_JSON}\\\\stdin.txt'; Get-ChildItem env: | Out-File -LiteralPath '${TEMP_JSON}\\\\env.txt'\",\"timeout\":10},{\"type\":\"command\",\"command\":\"echo posix-form-unused\",\"commandWindows\":\"& 'C:\\\\Windows\\\\System32\\\\cmd.exe' /c echo quotes-ran> '${TEMP_JSON}\\\\it’’s-‘‘q’’.txt'\",\"timeout\":10}]}]}",
    "--provider",
    "echo",
    "--echo-delay-ms",
    "5000",
    "--yolo",
    "--contributor-mode",
    "off"
   ],
   "env": {
    "MUSE_NO_AUTO_UPDATE": "1",
    "MUSE_LOGIN": "0",
    "XDG_CONFIG_HOME": "${TEMP}\\config",
    "XDG_DATA_HOME": "${TEMP}\\data",
