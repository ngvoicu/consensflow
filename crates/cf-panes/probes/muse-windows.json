    "--contributor-mode",
    "off"
   ],
   "env": {
    "MUSE_NO_AUTO_UPDATE": "1",
    "MUSE_LOGIN": "0",
    "XDG_CONFIG_HOME": "${TEMP}\\config",
    "XDG_DATA_HOME": "${TEMP}\\data",
    "HTTPS_PROXY": "http://127.0.0.1:9",
    "HTTP_PROXY": "http://127.0.0.1:9"
   },
   "steps": [
    {
     "after_ms": 8000,
     "note": "resumed on the session the case before left: its words shown?",
     "locks": true
    },
    {
     "paste": "probe three: after the resume",
     "enter_after_ms": 400,
     "note": "a turn in the resumed session",
     "locks": true
    },
    {
     "after_ms": 7000,
     "note": "done"
    }
   ],
   "temp_of_previous": true
  },
