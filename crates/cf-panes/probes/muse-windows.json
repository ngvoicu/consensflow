{
 "cases": [
  {
   "name": "muse",
   "argv": [
    "${LOCALAPPDATA}\\Programs\\muse\\muse-bin-1.4.13-R6996.1.exe",
    "--provider",
    "echo",
    "--echo-delay-ms",
    "5000",
    "--yolo",
    "--contributor-mode",
    "off"
   ],
   "env": {
    "MUSE_NO_AUTO_UPDATE": "1",
    "MUSE_LOGIN": "0",
    "XDG_CONFIG_HOME": "${TEMP}\\config",
    "XDG_DATA_HOME": "${TEMP}\\data",
    "HTTPS_PROXY": "http://127.0.0.1:9",
    "HTTP_PROXY": "http://127.0.0.1:9"
   },
   "steps": [
    {
     "after_ms": 8000,
     "mode": true,
     "note": "up, at rest",
     "locks": true
    },
    {
     "paste": "probe one: a paste and a plain CR",
     "enter_after_ms": 400,
     "mode": true,
     "note": "the pane host's paste",
     "locks": true
    },
    {
     "after_ms": 7000,
     "note": "the echo turn is done"
    },
    {
     "write": "typed words",
     "note": "words typed into the box"
    },
    {
     "after_ms": 500,
     "write": "\u0003",
     "note": "a plain Control-C byte into a box holding words"
    },
    {
     "after_ms": 500,
     "paste": "probe two: interrupted",
     "enter_after_ms": 400,
     "note": "a turn to interrupt"
    },
    {
     "after_ms": 1000,
     "write": "\u001b",
     "note": "a plain Escape while the turn works"
    },
    {
     "after_ms": 3000,
     "note": "after the Escape: the brief taken back?"
    },
    {
     "write": "\u0003",
     "note": "a plain Control-C into the box holding the brief taken back"
    },
    {
     "after_ms": 1000,
     "write": "\u0003",
     "mode": true,
     "note": "a plain Control-C into an empty box at rest (arms the quit)"
    },
    {
     "after_ms": 300,
     "write": "\u0003",
     "note": "a second within 1.5 s: quits?"
    },
    {
     "after_ms": 3000,
     "note": "after the quit"
    }
   ]
  },
  {
   "name": "muse-resumed",
   "argv": [
