{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "tests/**",
      "evals/**",
      "app/ui/*.js",
      "app/ui/core/**",
      "app/tests/**",
      "hosts/**",
      "crates/cf-e2e/fixtures/**",
      "*.ts",
      "*.json",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/test-results",
      "!!app/ui/vendor",
      "!!evals/reports"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  }
}
