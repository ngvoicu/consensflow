{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "src/**",
      "bin/**",
      "tests/**",
      "app/ui/*.js",
      "app/tests/**",
      "hosts/lib/completion.js",
      "hosts/lib/deliveries.js",
      "hosts/lib/inbox.js",
      "hosts/lib/receiver.js",
      "hosts/claude-receiver.mjs",
      "hosts/lib/policy.js",
      "hosts/lib/session-binding.js",
      "hosts/pi-extension/**",
      "hosts/opencode-extension/**",
      "hosts/codex-session.mjs",
      "*.ts",
      "*.json",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/test-results",
      "!!app/ui/vendor",
      "!!**/.specs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  }
}
