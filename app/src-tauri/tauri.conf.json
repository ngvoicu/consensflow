{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ConsensFlow",
  "version": "3.0.0-alpha.43",
  "identifier": "dev.ngvoicu.consensflow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ConsensFlow",
        "width": 880,
        "height": 900,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "exceptionDomain": "localhost",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/cli": "cli"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2OUU0RThEQzQzQUFERTIKUldUaXJUckVqVTZlcGdOMmM4eVYyYUlmUkh6Y0NIVkJpOXpkZGllUlZNNVNhaHdoREZKbEZkN1EK"
    }
  }
}
