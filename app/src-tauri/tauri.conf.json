{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ConsensFlow",
  "version": "3.0.5",
  "identifier": "dev.ngvoicu.consensflow",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run prepare:app",
    "beforeDevCommand": {
      "script": "npm run prepare:app",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ConsensFlow",
        "width": 880,
        "height": 900,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "exceptionDomain": "localhost",
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    },
    "resources": {
      "resources/cli": "cli"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2OUU0RThEQzQzQUFERTIKUldUaXJUckVqVTZlcGdOMmM4eVYyYUlmUkh6Y0NIVkJpOXpkZGllUlZNNVNhaHdoREZKbEZkN1EK"
    }
  }
}
