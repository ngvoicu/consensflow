{
  "name": "consensflow",
  "version": "3.0.0-alpha.72",
  "description": "Native terminal workspace where a Chief of Staff runs your project with a staff of coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "consensflow": "bin/cf.mjs",
    "cf": "bin/cf.mjs"
  },
  "files": [
    "bin",
    "src",
    "hosts",
    "skill",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/engine/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm test",
    "eval": "node evals/run.mjs",
    "eval:summary": "node evals/summarize.mjs",
    "watch": "node evals/watch.mjs",
    "eval:windows": "node tests/live/windows-matrix.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "build:bridge": "cargo build --release -p cf-panes --bin consensflow-bridge",
    "goldens:cf": "node tests/goldens/cf-board.mjs",
    "smoke": "CONSENSFLOW_SMOKE=1 node --test tests/smoke.test.mjs",
    "load": "CONSENSFLOW_LOAD=1 node --test tests/load/*.test.mjs",
    "candidate": "node app/scripts/candidate.mjs",
    "bench:core": "node tests/live/core-bench.mjs",
    "live:paste": "node tests/live/paste-submit.mjs",
    "live:interrupt": "node tests/live/interrupt-idle.mjs",
    "live:asks": "node tests/live/claude-asks.mjs",
    "live:codex-resume": "node tests/live/codex-resume.mjs",
    "windows": "node tests/live/windows.mjs",
    "check:all": "npm run check && cargo fmt --all --check && cargo test --offline --workspace && cargo clippy --offline --workspace --all-targets -- -D warnings && cargo fmt --check --manifest-path app/cf-launcher/Cargo.toml && cargo clippy --offline --manifest-path app/cf-launcher/Cargo.toml -- -D warnings && npm --prefix app run test:ui && npm run build:bridge -- --offline && npm run test:integration && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvoicu/consensflow.git"
  },
  "homepage": "https://consensflow.ngvoicu.dev",
  "bugs": "https://github.com/ngvoicu/consensflow/issues",
  "keywords": [
    "ai",
    "coding-agents",
    "skills",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "second-opinion"
  ],
  "author": "Gabriel Voicu (https://ngvoicu.dev)",
  "dependencies": {
    "ws": "8.21.3"
  }
}
