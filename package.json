{
  "name": "consensflow",
  "version": "3.0.0-alpha.81",
  "description": "Native terminal workspace where a Chief of Staff runs your project with a staff of coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "consensflow": "bin/cf.mjs",
    "cf": "bin/cf.mjs"
  },
  "files": [
    "bin",
    "src",
    "hosts",
    "skill",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/engine/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm test",
    "eval": "node evals/run.mjs",
    "eval:summary": "node evals/summarize.mjs",
    "watch": "node evals/watch.mjs",
    "eval:windows": "node tests/live/windows-matrix.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:daemons": "node tests/daemons.mjs",
    "test:agents": "node tests/agents-daemons.mjs",
    "test:clis": "node tests/clis.mjs",
    "test:app": "node tests/app-tests.mjs",
    "clippy:windows": "node tests/windows-clippy.mjs",
    "clippy:app": "node tests/app-clippy.mjs",
    "plants:daemon": "node tests/plants/daemon.mjs",
    "plants:cli": "node tests/plants/cli.mjs",
    "plants:release": "node tests/plants/release.mjs",
    "goldens:ledger": "node tests/goldens/ledger/record.mjs",
    "goldens:catalog": "node tests/goldens/catalog/record.mjs",
    "goldens:path": "node tests/goldens/path/record.mjs",
    "goldens:launch": "node tests/goldens/launch/record.mjs",
    "goldens:admin": "node tests/goldens/admin/record.mjs",
    "goldens:engine": "node tests/goldens/engine/record.mjs",
    "goldens:dispatcher": "node tests/goldens/engine/dispatcher/record.mjs",
    "goldens:records": "node tests/goldens/records/record.mjs",
    "goldens:errno": "node tests/goldens/errno/record.mjs",
    "goldens:unwritable": "node tests/goldens/unwritable/record.mjs",
    "goldens:daemon": "node tests/goldens/daemon/record.mjs",
    "goldens:launcher": "node tests/goldens/launcher/record.mjs",
    "goldens:cli": "node tests/goldens/cli/record.mjs",
    "goldens:departed": "node tests/goldens/departed.mjs",
    "parity:ledger": "npm run goldens:ledger && cargo test -p cf-ledger --test replay",
    "parity:records": "node tests/parity/records.mjs",
    "parity:launch": "node tests/parity/launch.mjs",
    "build:bridge": "cargo build --release -p cf-panes --bin consensflow-bridge",
    "build:cf": "node app/scripts/build-cf.mjs",
    "smoke": "CONSENSFLOW_SMOKE=1 node --test tests/smoke.test.mjs",
    "smoke:daemons": "node tests/smoke-daemons.mjs",
    "smoke:updater": "node tests/smoke-updater.mjs",
    "load": "CONSENSFLOW_LOAD=1 node --test tests/load/*.test.mjs",
    "candidate": "node app/scripts/candidate.mjs",
    "bench:core": "node tests/live/core-bench.mjs",
    "bench:records-memory": "node tests/bench/records-memory.mjs",
    "live:paste": "node tests/live/paste-submit.mjs",
    "live:interrupt": "node tests/live/interrupt-idle.mjs",
    "live:asks": "node tests/live/claude-asks.mjs",
    "live:codex-resume": "node tests/live/codex-resume.mjs",
    "live:terminal": "node tests/live/devin-terminal.mjs",
    "live:home-parity": "node tests/live/home-parity.mjs",
    "windows": "node tests/live/windows.mjs",
    "check:all": "npm run build:cf -- --offline && npm run check && cargo fmt --all --check && cargo test --offline --workspace && cargo clippy --offline --workspace --all-targets -- -D warnings && cargo test --offline -p cf-bridge --features local && cargo clippy --offline -p cf-bridge --features local --all-targets -- -D warnings && npm --prefix app run test:ui && npm run build:bridge -- --offline && npm run test:integration && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "ws": "8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvoicu/consensflow.git"
  },
  "homepage": "https://consensflow.ngvoicu.dev",
  "bugs": "https://github.com/ngvoicu/consensflow/issues",
  "keywords": [
    "ai",
    "coding-agents",
    "skills",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "second-opinion"
  ],
  "author": "Gabriel Voicu (https://ngvoicu.dev)"
}
