{
  "name": "consensflow",
  "version": "3.0.4",
  "description": "Native terminal workspace where a Chief of Staff runs your project with a staff of coding agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm test",
    "eval": "cargo xtask eval",
    "eval:summary": "cargo xtask eval summary",
    "watch": "cargo xtask watch",
    "eval:windows": "cargo xtask windows-matrix",
    "test:integration": "cargo xtask test integration",
    "test:regressions": "cargo xtask test regressions",
    "test:daemons": "cargo xtask test daemons",
    "test:agents": "cargo xtask test agents",
    "test:clis": "cargo xtask test clis",
    "test:app": "cargo xtask app test",
    "clippy:windows": "cargo xtask clippy-windows",
    "clippy:app": "cargo xtask app clippy",
    "plants:daemon": "cargo xtask plants daemon",
    "plants:cli": "cargo xtask plants cli",
    "plants:release": "cargo xtask plants release",
    "departures": "cargo xtask departures",
    "build:bridge": "cargo build --release -p cf-panes --bin consensflow-bridge",
    "build:cf": "cargo xtask build-cf",
    "smoke": "cargo xtask smoke",
    "smoke:updater": "cargo xtask smoke-updater",
    "load": "cargo xtask test load",
    "candidate": "cargo xtask candidate",
    "bench:core": "cargo xtask live bench",
    "bench:records-memory": "cargo xtask bench records-memory",
    "live:paste": "cargo xtask live paste",
    "live:agent": "cargo xtask live agent",
    "live:interrupt": "cargo xtask live interrupt",
    "live:stops": "cargo xtask live stops",
    "live:input-box": "cargo xtask live input-box",
    "live:resume-cut": "cargo xtask live resume-cut",
    "live:resume-fresh": "cargo xtask live resume-fresh",
    "live:restart-cut": "cargo xtask live restart-cut",
    "live:door": "cargo xtask live door",
    "live:hook-status": "cargo xtask live door claude --hold 90",
    "live:codex-interrupt": "cargo xtask live codex-interrupt",
    "live:asks": "cargo xtask live asks",
    "live:codex-resume": "cargo xtask live codex-resume",
    "live:terminal": "cargo xtask live terminal",
    "live:designer": "cargo xtask live designer",
    "live:approval": "cargo xtask live approval",
    "live:mcp": "cargo xtask live mcp",
    "live:finish": "cargo xtask live finish",
    "live:notes": "cargo xtask live notes",
    "live:wake-ups": "cargo xtask live wake-ups",
    "live:specs": "cargo xtask live specs",
    "windows": "cargo xtask windows",
    "check:all": "cargo xtask check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvoicu/consensflow.git"
  },
  "homepage": "https://consensflow.ngvoicu.dev",
  "bugs": "https://github.com/ngvoicu/consensflow/issues",
  "keywords": [
    "ai",
    "coding-agents",
    "skills",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "second-opinion"
  ],
  "author": "Gabriel Voicu (https://ngvoicu.dev)"
}
