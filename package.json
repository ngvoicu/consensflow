{
  "name": "consensflow",
  "version": "3.0.0-alpha.63",
  "description": "Native terminal workspace for a lead, named workers and a project manager.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "consensflow": "bin/cf.mjs",
    "cf": "bin/cf.mjs"
  },
  "files": [
    "bin",
    "src",
    "hosts",
    "skill",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/engine/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm test",
    "eval": "node evals/run.mjs",
    "eval:summary": "node evals/summarize.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "smoke": "CONSENSFLOW_SMOKE=1 node --test tests/smoke.test.mjs",
    "load": "CONSENSFLOW_LOAD=1 node --test tests/load/*.test.mjs",
    "candidate": "node app/scripts/candidate.mjs",
    "bench:core": "node tests/live/core-bench.mjs",
    "check:all": "npm run check && cargo test --offline --manifest-path app/src-tauri/Cargo.toml && cargo clippy --offline --manifest-path app/src-tauri/Cargo.toml --all-targets -- -D warnings && npm --prefix app run test:ui && npm run test:integration && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvoicu/consensflow.git"
  },
  "homepage": "https://consensflow.ngvoicu.dev",
  "bugs": "https://github.com/ngvoicu/consensflow/issues",
  "keywords": [
    "ai",
    "coding-agents",
    "skills",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "second-opinion"
  ],
  "author": "Gabriel Voicu (https://ngvoicu.dev)",
  "dependencies": {
    "ws": "8.21.3"
  }
}
